// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  ADMIN
  CLEANER
  REPAIRMAN
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum StaffAvailability {
  AVAILABLE
  UNAVAILABLE
  VACATION
  SICK_LEAVE
  DAY_OFF
}

model Staff {
  id              String              @id @default(uuid())
  staffId         String              @unique 

  name            String
  role            StaffRole
  status          StaffStatus         @default(ACTIVE)
  availability    StaffAvailability   @default(AVAILABLE)


  email           String?             @unique
  hashedPassword  String?             @unique 
  hashedPinCode   String? 

  maintenanceIssue  MaintenanceIssue[]

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Guest {
  id              String              @id @default(uuid())

  reservations     Reservation[]

  fullName        String     
  phoneNumber     String              
  email           String              @unique

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

enum RoomType {
  STANDARD
  SUPERIOR
  DELUXE
  PREMIUM
  LUXURY
}

enum RoomOccupancyStatus {
  VACANT
  OCCUPIED
}

enum HousekeepingStatus {
  CLEAN
  DIRTY
  CLEANING
  INSPECTION_REQUIRED
}

enum RoomMaintenanceStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  OUT_OF_ORDER
}

model Room {
  id                      String                          @id @default(uuid())
  number                  String                          @unique
  floor                   Int

  reservations               Reservation[]

  type                    RoomType
  capacity                Int

  occupancyStatus         RoomOccupancyStatus       @default(VACANT)
  housekeepingStatus      HousekeepingStatus        @default(CLEAN)

  maintenanceStatus       RoomMaintenanceStatus     @default(OPERATIONAL)
  maintenanceIssue        MaintenanceIssue[]

  isActive                Boolean                    @default(true)

  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
}

enum MaintenanceIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

model MaintenanceIssue {
  id                String                           @id @default(uuid())
  roomId            String
  description       String
  createdById       String

  status            MaintenanceIssueStatus           @default(OPEN)

  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt
  resolvedAt        DateTime?

  room              Room                             @relation(fields: [roomId], references: [id])
  createdBy         Staff                            @relation(fields: [createdById], references: [id])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
}

model Reservation {
  id                 String                           @id @default(uuid())
  reservationNumber  String                           @unique
  
  roomId             String
  room               Room                             @relation(fields: [roomId], references: [id])
  
  guestId            String
  guest              Guest                            @relation(fields: [guestId], references: [id])
  guestCount         Int 

  checkInDate        DateTime
  checkOutDate       DateTime

  reservationStatus   ReservationStatus                @default(PENDING)
  cancelledAt        DateTime?
  notes              String?

  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                           @updatedAt        
}

model ReservationCounter {
  year        Int      @id
  lastNumber  Int      @default(0)
  updatedAt   DateTime @updatedAt
}

