// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  ADMIN
  CLEANER
  REPAIRMAN
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum StaffAvailability {
  AVAILABLE
  UNAVAILABLE
  VACATION
  SICK_LEAVE
  DAY_OFF
}

model Staff {
  id              String              @id @default(uuid())
  staffId         String              @unique 

  name            String
  role            StaffRole
  status          StaffStatus         @default(ACTIVE)
  availability    StaffAvailability   @default(AVAILABLE)


  email           String?             @unique
  hashedPassword  String?             @unique 
  hashedPinCode   String? 

  maintenanceIssue  MaintenanceIssue[]

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Guest {
  id              String              @id @default(uuid())
  name            String     
  phone           String              @unique
  email           String              @unique

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

enum RoomType {
  STANDARD
  SUPERIOR
  DELUXE
  PREMIUM
  LUXURY
}

enum RoomOccupancyStatus {
  VACANT
  OCCUPIED
}

enum HousekeepingStatus {
  CLEAN
  DIRTY
  CLEANING
  INSPECTION_REQUIRED
}

enum RoomMaintenanceStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  OUT_OF_ORDER
}

model Room {
  id                      String                          @id @default(uuid())
  number                  String                          @unique
  floor                   Int

  type                    RoomType
  capacity                Int

  occupancyStatus         RoomOccupancyStatus       @default(VACANT)
  housekeepingStatus      HousekeepingStatus        @default(CLEAN)

  maintenanceStatus       RoomMaintenanceStatus     @default(OPERATIONAL)
  maintenanceIssue        MaintenanceIssue[]

  isActive                Boolean                        @default(true)

  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
}

enum MaintenanceIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

model MaintenanceIssue {
  id                String                          @id @default(uuid())
  roomId            String
  description       String
  createdById       String

  status            MaintenanceIssueStatus          @default(OPEN)

  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  resolvedAt        DateTime?

  room              Room                            @relation(fields: [roomId], references: [id])
  createdBy         Staff                           @relation(fields: [createdById], references: [id])
}


